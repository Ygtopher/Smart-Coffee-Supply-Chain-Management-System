datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  roleId      String   @id @default(uuid()) @map("role_id")
  roleName    String   @unique @map("role_name") @db.VarChar(100)
  permissions Json     @map("permissions")

  users       User[]

  @@map("roles")
}

model User {
  userId         String   @id @default(uuid()) @map("user_id")
  roleId         String   @map("role_id")
  role           Role     @relation(fields: [roleId], references: [roleId])
  
  fullName       String?  @map("full_name") @db.VarChar(150)
  phone          String?  @map("phone") @db.VarChar(20)
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  
  mfaEnabled     Boolean  @default(false) @map("mfa_enabled")
  mfaCode        String?  @map("mfa_code") @db.VarChar(10)
  mfaExpires     DateTime? @map("mfa_expires")
  
  resetToken     String?  @map("reset_token") @db.VarChar(255)
  resetTokenExpires DateTime? @map("reset_token_expires")
  
  qrLoginSecret  String?  @map("qr_login_secret") @db.VarChar(255)
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  managedCooperatives    Cooperative[]
  cooperativeAssignments CooperativeAggregator[]
  farmedBatches          CoffeeBatch[]
  scannedCheckpoints     CheckpointLog[]
  scannedTransports      TransportLog[]
  qualityAssessments     QualityAssessment[]
  communityPosts         CommunityPost[]
  communityReplies       CommunityReply[]
  communityReactions     CommunityReaction[]
  paymentsMade           PaymentTransaction[]
  auditLogs              AuditLog[]
  farmerProfile          FarmerProfile?
  assignedFarmers        FarmerProfile[] @relation("AggregatorToFarmer")
  pickupRequests         PickupRequest[] @relation("FarmerPickupRequests")
  supportTickets         SupportTicket[] @relation("FarmerSupportTickets")

  @@map("users")
}

model FarmerProfile {
  profileId      String   @id @default(uuid()) @map("profile_id")
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [userId])
  farmName       String   @map("farm_name") @db.VarChar(150)
  farmSizeHa     Float    @map("farm_size_ha")
  gpsLocation    String?  @map("gps_location") 
  coordinates    String?  @map("coordinates")
  coffeeVarieties String? @map("coffee_varieties") @db.Text
  supplierType   String   @default("FARMER") @map("supplier_type") @db.VarChar(30)
  numberOfFarms  Int?     @map("number_of_farms")
  preferredWashingStation String? @map("preferred_washing_station") @db.VarChar(150)
  processorId    String?  @map("processor_id")
  assignmentStatus String @default("PENDING_ASSIGNMENT") @map("assignment_status") @db.VarChar(30)
  status         String   @default("active") @db.VarChar(20)
  
  aggregatorId   String?  @map("aggregator_id")
  aggregator     User?    @relation("AggregatorToFarmer", fields: [aggregatorId], references: [userId])
  
  cooperativeId  String?  @map("cooperative_id")
  cooperative    Cooperative? @relation(fields: [cooperativeId], references: [coopId])

  @@map("farmer_profiles")
}

model Cooperative {
  coopId         String   @id @default(uuid()) @map("coop_id")
  name           String   @db.VarChar(150)
  district       String   @db.VarChar(100)
  zone           String   @db.VarChar(100)
  managerId      String   @map("manager_id")
  manager        User     @relation(fields: [managerId], references: [userId])
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  sustainabilityMetrics SustainabilityMetric[]
  farmerProfiles        FarmerProfile[]
  aggregatorAssignments CooperativeAggregator[]

  @@map("cooperatives")
}

model CooperativeAggregator {
  assignmentId String   @id @default(uuid()) @map("assignment_id")
  coopId       String   @map("coop_id")
  cooperative  Cooperative @relation(fields: [coopId], references: [coopId], onDelete: Cascade)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  isPrimary    Boolean  @default(false) @map("is_primary")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  @@unique([coopId, userId])
  @@map("cooperative_aggregators")
}

model CoffeeBatch {
  batchId         String   @id @default(uuid()) @map("batch_id")
  qrCode          String   @unique @map("qr_code") @db.VarChar(100)
  farmName        String   @map("farm_name") @db.VarChar(150)
  washingStation  String   @map("washing_station") @db.VarChar(150)
  district        String   @db.VarChar(100)
  farmerId        String   @map("farmer_id")
  farmer          User     @relation(fields: [farmerId], references: [userId])
  weightCherry    Decimal  @map("weight_cherry") @db.Decimal(12, 2)
  coffeeVariety   String?  @map("coffee_variety") @db.VarChar(100)
  status          String   @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  rfidTag         String?  @unique @map("rfid_tag") @db.VarChar(100)
  certificationStatus Json? @map("certification_status")

  batchGroupId    String?  @map("batch_group_id") @db.VarChar(100)
  parentBatchId   String?  @map("parent_batch_id")
  parentBatch     CoffeeBatch?  @relation("BatchLineage", fields: [parentBatchId], references: [batchId])
  childBatches    CoffeeBatch[] @relation("BatchLineage")

  checkpointLogs     CheckpointLog[]
  transportLogs      TransportLog[]
  inventoryItems     InventoryItem[]
  qualityAssessments QualityAssessment[]
  shippingRecords    ShippingRecord[]

  @@map("coffee_batches")
}

model CheckpointLog {
  logId           String   @id @default(uuid()) @map("log_id")
  batchId         String   @map("batch_id")
  batch           CoffeeBatch @relation(fields: [batchId], references: [batchId])
  checkpointType  String   @map("checkpoint_type") @db.VarChar(50)
  locationName    String   @map("location_name") @db.VarChar(150)
  timestamp       DateTime
  scannedById     String   @map("scanned_by")
  scannedBy       User     @relation(fields: [scannedById], references: [userId])
  notes           String?  @db.Text

  @@map("checkpoint_logs")
}

model TransportLog {
  logId           String   @id @default(uuid()) @map("log_id")
  batchId         String   @map("batch_id")
  batch           CoffeeBatch @relation(fields: [batchId], references: [batchId])
  transportMethod String   @map("transport_method") @db.VarChar(100)
  departureTime   DateTime @map("departure_time")
  arrivalTime     DateTime? @map("arrival_time")
  condition       String   @db.VarChar(100)
  scannedById     String   @map("scanned_by")
  scannedBy       User     @relation(fields: [scannedById], references: [userId])
  notes           String?  @db.Text

  @@map("transport_logs")
}

model WarehouseLocation {
  locationId      String   @id @default(uuid()) @map("location_id")
  name            String   @db.VarChar(150)
  type            String   @db.VarChar(50)
  address         String   @db.VarChar(255)
  district        String   @db.VarChar(100)
  capacityKg      Decimal  @map("capacity_kg") @db.Decimal(14, 2)
  status          String   @default("active") @db.VarChar(20)
  processorId     String?  @map("processor_id")
  
  gpsLocation     String?  @map("gps_location")

  inventoryItems  InventoryItem[]

  @@map("warehouse_locations")
}

model InventoryItem {
  itemId          String   @id @default(uuid()) @map("item_id")
  batchId         String   @map("batch_id")
  batch           CoffeeBatch @relation(fields: [batchId], references: [batchId])
  warehouseId     String   @map("warehouse_id")
  warehouse       WarehouseLocation @relation(fields: [warehouseId], references: [locationId])
  quantityKg      Decimal  @map("quantity_kg") @db.Decimal(12, 2)
  coffeeForm      String   @map("coffee_form") @db.VarChar(50)
  fifoDate        DateTime @map("fifo_date") @db.Date
  status          String   @db.VarChar(50)
  lotNo           String?  @map("lot_no")
  binCode         String?  @map("bin_code") @db.VarChar(100)
  expiryDate      DateTime? @map("expiry_date") @db.Date
  reorderLevelKg  Decimal? @map("reorder_level_kg") @db.Decimal(12, 2)
  alertStatus     String   @default("OK") @map("alert_status") @db.VarChar(50)

  stockMovements  StockMovement[]

  @@map("inventory_items")
}

model StockMovement {
  movementId      String   @id @default(uuid()) @map("movement_id")
  itemId          String   @map("item_id")
  inventoryItem   InventoryItem @relation(fields: [itemId], references: [itemId])
  movementType    String   @map("movement_type") @db.VarChar(50)
  quantityKg      Decimal  @map("quantity_kg") @db.Decimal(12, 2)
  fromLocationId  String?  @map("from_location_id")
  toLocationId    String?  @map("to_location_id")
  movementDate    DateTime @default(now()) @map("movement_date")
  referenceNo     String?  @map("reference_no") @db.VarChar(100)

  @@map("stock_movements")
}

model QualityAssessment {
  assessmentId    String   @id @default(uuid()) @map("assessment_id")
  batchId         String   @map("batch_id")
  batch           CoffeeBatch @relation(fields: [batchId], references: [batchId])
  cuppingScore    Decimal  @map("cupping_score") @db.Decimal(5, 2)
  moisture        Decimal  @db.Decimal(5, 2)
  defects         Json?
  assessorId      String   @map("assessor_id")
  assessor        User     @relation(fields: [assessorId], references: [userId])
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("quality_assessments")
}

model ShippingRecord {
  shipmentId      String   @id @default(uuid()) @map("shipment_id")
  batchId         String   @map("batch_id")
  batch           CoffeeBatch @relation(fields: [batchId], references: [batchId])
  containerNo     String   @map("container_no") @db.VarChar(100)
  vesselName      String   @map("vessel_name") @db.VarChar(150)
  portLoading     String   @map("port_loading") @db.VarChar(150)
  portDestination String   @map("port_destination") @db.VarChar(150)
  status          String   @db.VarChar(50)
  shippedAt       DateTime? @map("shipped_at")

  complianceDocs  ComplianceDocument[]

  @@map("shipping_records")
}

model ComplianceDocument {
  docId           String   @id @default(uuid()) @map("doc_id")
  shipmentId      String?  @map("shipment_id")
  shippingRecord  ShippingRecord? @relation(fields: [shipmentId], references: [shipmentId])
  batchId         String?  @map("batch_id")
  documentType    String?  @map("document_type") @db.VarChar(100)
  naebLicense     String?  @map("naeb_license") @db.VarChar(100)
  eudrVerifiedLoc String?  @map("eudr_verified_location") @db.VarChar(150)
  certificationType String @map("certification_type") @db.VarChar(100)
  status          String   @db.VarChar(50)
  expiryDate      DateTime? @map("expiry_date")
  fileUrl         String?  @map("file_url")
  generatedAt     DateTime @default(now()) @map("generated_at")

  @@map("compliance_docs")
}

model SustainabilityMetric {
  metricId        String   @id @default(uuid()) @map("metric_id")
  farmId          String   @map("farm_id")
  cooperative     Cooperative @relation(fields: [farmId], references: [coopId])
  carbonKg        Decimal  @map("carbon_kg") @db.Decimal(12, 2)
  waterLiters     Decimal  @map("water_liters") @db.Decimal(12, 2)
  socialScore     Decimal  @map("social_score") @db.Decimal(5, 2)
  reportingPeriod DateTime @map("reporting_period") @db.Date
  biodiversityScore Decimal? @map("biodiversity_score") @db.Decimal(5, 2)
  soilHealthScore Decimal? @map("soil_health_score") @db.Decimal(5, 2)
  genderInclusionScore Decimal? @map("gender_inclusion_score") @db.Decimal(5, 2)
  sdgSummary      Json?    @map("sdg_summary")
  improvementGoals Json?   @map("improvement_goals")

  @@map("sustainability_metrics")
}

model CommunityPost {
  postId          String   @id @default(uuid()) @map("post_id")
  authorId        String   @map("author_id")
  author          User     @relation(fields: [authorId], references: [userId])
  groupId         String   @map("group_id") @db.VarChar(100)
  content         String   @db.Text
  imageUrl        String?  @map("image_url") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  status          String   @default("active") @db.VarChar(20)
  replies         CommunityReply[]
  reactions       CommunityReaction[]

  @@map("community_posts")
}

model CommunityReply {
  replyId   String   @id @default(uuid()) @map("reply_id")
  postId    String   @map("post_id")
  post      CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [userId], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  status    String   @default("active") @db.VarChar(20)

  @@map("community_replies")
}

model CommunityReaction {
  reactionId   String   @id @default(uuid()) @map("reaction_id")
  postId       String   @map("post_id")
  post         CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reactionType String   @default("like") @map("reaction_type") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([postId, userId, reactionType])
  @@map("community_reactions")
}

model PaymentTransaction {
  txId            String   @id @default(uuid()) @map("tx_id")
  payerId         String   @map("payer_id")
  payer           User     @relation(fields: [payerId], references: [userId])
  deliveryId      String?  @map("delivery_id")
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(20)
  referenceCode   String   @unique @map("reference_code") @db.VarChar(150)
  status          String   @db.VarChar(50)
  processedAt     DateTime? @map("processed_at")

  @@index([deliveryId])
  @@map("payment_transactions")
}

model AuditLog {
  logId           String   @id @default(uuid()) @map("log_id")
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [userId])
  action          String   @db.VarChar(100)
  entityType      String   @map("entity_type") @db.VarChar(100)
  entityId        String?  @map("entity_id")
  details         Json?    
  ipAddress       String?  @map("ip_address")
  timestamp       DateTime @default(now())

  @@map("audit_logs")
}

model RegulationRule {
  ruleId          String   @id @default(uuid()) @map("rule_id")
  regulationType  String   @map("regulation_type") @db.VarChar(100)
  title           String   @db.VarChar(255)
  description     String   @db.Text
  ruleJson        Json     @map("rule_json")

  @@map("regulation_rules")
}

model AnalyticsReport {
  reportId        String   @id @default(uuid()) @map("report_id")
  reportType      String   @map("report_type") @db.VarChar(100)
  parameters      Json
  generatedById   String   @map("generated_by")
  generatedAt     DateTime @default(now()) @map("generated_at")
  dataRange       String   @map("data_range") @db.VarChar(100)
  fileUrl         String   @map("file_url") @db.VarChar(255)

  @@map("analytics_reports")
}

model DeliveryRecord {
  deliveryId      String   @id @default(uuid()) @map("delivery_id")
  profileId       String   @map("profile_id")
  batchId         String   @map("batch_id")
  deliveryDate    DateTime @map("delivery_date") @db.Date
  weightKg        Decimal  @map("weight_kg") @db.Decimal(12, 2)
  buyer           String   @db.VarChar(150)
  pricePerKg      Decimal  @map("price_per_kg") @db.Decimal(12, 2)
  coffeeVariety   String?  @map("coffee_variety") @db.VarChar(100)

  @@map("delivery_records")
}

model ExportOrder {
  orderId         String   @id @default(uuid()) @map("order_id")
  referenceCode   String?  @unique @map("reference_code") @db.VarChar(50)
  buyer           String   @db.VarChar(150)
  customerEmail   String?  @map("customer_email") @db.VarChar(255)
  customerPhone   String?  @map("customer_phone") @db.VarChar(50)
  companyName     String?  @map("company_name") @db.VarChar(150)
  country         String   @db.VarChar(100)
  batchId         String?  @map("batch_id")
  weight          Decimal  @db.Decimal(12, 2)
  grade           String   @db.VarChar(50)
  pricePerKg      Decimal  @map("price_per_kg") @db.Decimal(12, 2)
  totalValue      Decimal  @map("total_value") @db.Decimal(15, 2)
  status          String   @db.VarChar(50)
  orderDate       DateTime @default(now()) @map("order_date")
  shipmentId      String?  @map("shipment_id")
  incoterm         String?  @db.VarChar(20)
  qualitySpecs    Json?    @map("quality_specs")
  shipmentRequirements Json? @map("shipment_requirements")
  customerMessage String?  @map("customer_message") @db.Text
  quoteNotes      String?  @map("quote_notes") @db.Text

  messages        CustomerOrderMessage[]

  @@map("export_orders")
}

model CustomerOrderMessage {
  messageId       String   @id @default(uuid()) @map("message_id")
  orderId         String   @map("order_id")
  order           ExportOrder @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  senderType      String   @map("sender_type") @db.VarChar(30)
  senderName      String   @map("sender_name") @db.VarChar(150)
  message         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("customer_order_messages")
}

model Contract {
  contractId      String   @id @default(uuid()) @map("contract_id")
  buyer           String   @db.VarChar(150)
  country         String   @db.VarChar(100)
  type            String   @db.VarChar(50)
  grade           String   @db.VarChar(50)
  quantity        Decimal  @db.Decimal(12, 2)
  pricePerKg      Decimal  @map("price_per_kg") @db.Decimal(12, 2)
  totalValue      Decimal  @map("total_value") @db.Decimal(15, 2)
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  status          String   @db.VarChar(20)
  deliverySchedule String? @map("delivery_schedule") @db.Text
  paymentTerms    String?  @map("payment_terms") @db.VarChar(255)
  qualitySpecs    String?  @map("quality_specs") @db.Text
  penalties       String?  @db.Text
  deliveredWeight Decimal  @default(0) @map("delivered_weight") @db.Decimal(12, 2)

  @@map("contracts")
}

model Notification {
  notificationId  String   @id @default(uuid()) @map("notification_id")
  userId          String   @map("user_id")
  title           String   @db.VarChar(150)
  message         String   @db.Text
  type            String   @db.VarChar(20) // info, success, warning, error
  read            Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model PickupRequest {
  requestId       String   @id @default(uuid()) @map("request_id")
  farmerId        String   @map("farmer_id")
  farmer          User     @relation("FarmerPickupRequests", fields: [farmerId], references: [userId])
  status          String   @default("PENDING") @db.VarChar(20)
  requestedDate   DateTime @default(now()) @map("requested_date")
  pickupDate      DateTime? @map("pickup_date")
  weightEstimate  Decimal  @map("weight_estimate") @db.Decimal(12, 2)
  farmCoordinates String?  @map("farm_coordinates") @db.VarChar(100)
  farmLocation    String?  @map("farm_location") @db.VarChar(255)
  coffeeVariety   String?  @map("coffee_variety") @db.VarChar(100)
  receiptUrl      String?  @map("receipt_url") @db.Text
  receiptFileName String?  @map("receipt_file_name") @db.VarChar(255)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pickup_requests")
}

model WashingStationRequest {
  requestId             String   @id @default(uuid()) @map("request_id")
  supplierId            String   @map("supplier_id")
  washingStationName    String   @map("washing_station_name") @db.VarChar(150)
  currentWashingStation String?  @map("current_washing_station") @db.VarChar(150)
  reason                String?  @db.Text
  status                String   @default("PENDING") @db.VarChar(30)
  reviewedByProcessorId String?  @map("reviewed_by_processor_id")
  assignedAggregatorId  String?  @map("assigned_aggregator_id")
  createdAt             DateTime @default(now()) @map("created_at")
  reviewedAt            DateTime? @map("reviewed_at")

  @@map("washing_station_requests")
}

model KnowledgeArticle {
  articleId       String   @id @default(uuid()) @map("article_id")
  title           String   @db.VarChar(255)
  excerpt         String   @db.Text
  content         String   @db.Text
  category        String   @db.VarChar(100)
  tags            Json
  author          String   @db.VarChar(150)
  farm            String?  @db.VarChar(150)
  views           Int      @default(0)
  helpful         Int      @default(0)
  publishedAt     DateTime @default(now()) @map("published_at")

  @@map("knowledge_articles")
}

model SupportTicket {
  ticketId        String   @id @default(uuid()) @map("ticket_id")
  farmerId        String   @map("farmer_id")
  farmer          User     @relation("FarmerSupportTickets", fields: [farmerId], references: [userId])
  subject         String   @db.VarChar(255)
  category        String   @db.VarChar(100)
  description     String   @db.Text
  status          String   @default("Open") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model FarmerServiceRequest {
  requestId     String   @id @default(uuid()) @map("request_id")
  farmerId      String   @map("farmer_id")
  requestType   String   @map("request_type") @db.VarChar(80)
  description   String   @db.Text
  quantity      String?  @db.VarChar(80)
  preferredDate DateTime? @map("preferred_date") @db.Date
  status        String   @default("Open") @db.VarChar(50)
  response      String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("farmer_service_requests")
}

model AuditSchedule {
  scheduleId    String   @id @default(uuid()) @map("schedule_id")
  title         String   @db.VarChar(180)
  auditType     String   @map("audit_type") @db.VarChar(80)
  scheduledDate DateTime @map("scheduled_date") @db.Date
  ownerRole     String   @default("ADMIN") @map("owner_role") @db.VarChar(80)
  checklist     Json
  riskScore     Int      @default(0) @map("risk_score")
  status        String   @default("Scheduled") @db.VarChar(50)
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("audit_schedules")
}

model AccessRequest {
  requestId       String   @id @default(uuid()) @map("request_id")
  userId          String   @map("user_id")
  requestedModule String   @map("requested_module") @db.VarChar(120)
  reason          String   @db.Text
  sensitivity     String   @default("Internal") @db.VarChar(50)
  status          String   @default("Pending") @db.VarChar(50)
  reviewedBy      String?  @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("access_requests")
}

model LabSyncRecord {
  syncId     String   @id @default(uuid()) @map("sync_id")
  batchId    String?  @map("batch_id")
  labName    String   @map("lab_name") @db.VarChar(150)
  sampleCode String   @map("sample_code") @db.VarChar(100)
  payload    Json
  status     String   @default("Received") @db.VarChar(50)
  syncedAt   DateTime @default(now()) @map("synced_at")

  @@map("lab_sync_records")
}

model CertificationSyncRecord {
  syncId            String   @id @default(uuid()) @map("sync_id")
  certificationBody String   @map("certification_body") @db.VarChar(120)
  standard          String   @db.VarChar(120)
  batchId           String?  @map("batch_id")
  status            String   @default("Ready") @db.VarChar(50)
  requestPayload    Json     @map("request_payload")
  responsePayload   Json?    @map("response_payload")
  syncedAt          DateTime @default(now()) @map("synced_at")

  @@map("certification_sync_records")
}

model BuyerQualityRequirement {
  requirementId   String   @id @default(uuid()) @map("requirement_id")
  orderId         String?  @map("order_id")
  buyer           String   @db.VarChar(150)
  grade           String   @db.VarChar(50)
  minCuppingScore Decimal  @default(80) @map("min_cupping_score") @db.Decimal(4, 2)
  moistureMin     Decimal  @default(10) @map("moisture_min") @db.Decimal(5, 2)
  moistureMax     Decimal  @default(12) @map("moisture_max") @db.Decimal(5, 2)
  maxDefects      Int      @default(10) @map("max_defects")
  notes           String?  @db.Text
  status          String   @default("Active") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("buyer_quality_requirements")
}
